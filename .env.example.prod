# =============================================================================
# graft-cli — .env.example.prod
# =============================================================================
# NOTE: graft-cli does NOT load `.env` files (no dotenv). These variables are
# read from the shell environment only. The production values are the CLI
# defaults — set them explicitly only if you want them pinned.
# =============================================================================

# Default API base URL (no need to set it in production).
GUAYABA_API_BASE_URL=https://api.guayaba.run/api/v1

# Account master API key (g_master_*). Required for push/pull operations;
# prompted interactively in a TTY when unset.
GUAYABA_API_KEY=<your g_master_* key>
