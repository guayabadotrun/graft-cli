# =============================================================================
# graft-cli — .env.example.local
# =============================================================================
# NOTE: graft-cli does NOT load `.env` files (no dotenv). These variables are
# read from the shell environment only:
#
#   export GUAYABA_API_BASE_URL=...
#   export GUAYABA_API_KEY=g_master_...
#
# or use direnv (`.envrc`) / your shell profile. This file exists as
# documentation of the supported overrides.
#
# Both variables are optional: the API URL defaults to production and the key
# is prompted interactively in a TTY.
# =============================================================================

# Override the API base URL (default: https://api.guayaba.run/api/v1).
# Point at a local backend to test against your dev stack.
GUAYABA_API_BASE_URL=http://localhost:9090/api/v1

# Account master API key (g_master_*). Required for push/pull operations.
GUAYABA_API_KEY=<your g_master_* key>
