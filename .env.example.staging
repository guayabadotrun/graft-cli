# =============================================================================
# graft-cli — .env.example.staging
# =============================================================================
# NOTE: graft-cli does NOT load `.env` files (no dotenv). These variables are
# read from the shell environment only:
#
#   export GUAYABA_API_BASE_URL=https://api.staging.guayaba.run/api/v1
#   export GUAYABA_API_KEY=g_master_...
#
# Use this when testing a staging build of the CLI against the staging
# backend. Both variables are optional for a published CLI (defaults to prod).
# =============================================================================

GUAYABA_API_BASE_URL=https://api.staging.guayaba.run/api/v1
GUAYABA_API_KEY=<your g_master_* staging key>
